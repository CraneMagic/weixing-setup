  "description": "Weixing 工控设备监控 - 主机 + 容器 + 业务指标",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 8 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "avg(weixing_camera_fps{pc_num=~\"$pc_num\"})",
          "refId": "A"
        }
      ],
      "title": "相机 FPS (平均)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "100 - (avg by (pc_num) (rate(node_cpu_seconds_total{mode=\"idle\",pc_num=~\"$pc_num\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "title": "主机 CPU 使用率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{pc_num=~\"$pc_num\"} / node_memory_MemTotal_bytes{pc_num=~\"$pc_num\"}) * 100",
          "refId": "A"
        }
      ],
      "title": "主机内存使用率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(weixing_tcp_queue_size{pc_num=~\"$pc_num\"})",
          "refId": "A"
        }
      ],
      "title": "TCP 处理队列总长度",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "min", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "weixing_camera_fps{pc_num=~\"$pc_num\"}",
          "legendFormat": "{{pc_num}} / {{client_ip}}",
          "refId": "A"
        }
      ],
      "title": "相机 FPS 时间序列",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "weixing_tcp_queue_size{pc_num=~\"$pc_num\"}",
          "legendFormat": "{{pc_num}} / cam-{{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "TCP 处理队列长度(按相机)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, pc_num, camera_id) (rate(weixing_tcp_handler_duration_seconds_bucket{pc_num=~\"$pc_num\"}[5m])))",
          "legendFormat": "p50 {{pc_num}}/cam-{{camera_id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, pc_num, camera_id) (rate(weixing_tcp_handler_duration_seconds_bucket{pc_num=~\"$pc_num\"}[5m])))",
          "legendFormat": "p95 {{pc_num}}/cam-{{camera_id}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, pc_num, camera_id) (rate(weixing_tcp_handler_duration_seconds_bucket{pc_num=~\"$pc_num\"}[5m])))",
          "legendFormat": "p99 {{pc_num}}/cam-{{camera_id}}",
          "refId": "C"
        }
      ],
      "title": "TCP Handler 耗时分位数",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (pc_num) (rate(weixing_tcp_queue_dropped_total{pc_num=~\"$pc_num\"}[5m]))",
          "legendFormat": "队列丢弃 {{pc_num}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pc_num) (rate(weixing_tcp_ws_send_failures_total{pc_num=~\"$pc_num\"}[5m]))",
          "legendFormat": "WS 失败 {{pc_num}}",
          "refId": "B"
        },
        {
          "expr": "sum by (pc_num) (rate(weixing_tcp_db_write_failures_total{pc_num=~\"$pc_num\"}[5m]))",
          "legendFormat": "DB 失败 {{pc_num}}",
          "refId": "C"
        },
        {
          "expr": "sum by (pc_num) (rate(weixing_tcp_send_failures_total{pc_num=~\"$pc_num\"}[5m]))",
          "legendFormat": "相机 TCP 失败 {{pc_num}}",
          "refId": "D"
        }
      ],
      "title": "错误率 (5min rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, pc_num) (rate(weixing_cv_inference_duration_seconds_bucket{pc_num=~\"$pc_num\"}[5m])))",
          "legendFormat": "CV p95 {{pc_num}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, pc_num) (rate(weixing_cv_inference_duration_seconds_bucket{pc_num=~\"$pc_num\"}[5m])))",
          "legendFormat": "CV p99 {{pc_num}}",
          "refId": "B"
        }
      ],
      "title": "CV 校准耗时",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/host/root\",pc_num=~\"$pc_num\"} / node_filesystem_size_bytes{mountpoint=\"/host/root\",pc_num=~\"$pc_num\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pc_num}}",
          "refId": "A"
        }
      ],
      "title": "磁盘使用率 (%)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "device": true,
              "fstype": true,
              "instance": true,
              "job": true,
              "mountpoint": true
            },
            "indexByName": {},
            "renameByName": {
              "pc_num": "工控编号",
              "Value": "使用率 %"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
