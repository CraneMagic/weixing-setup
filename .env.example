PC_NUM=tongrang-LABUNKNOWN

# USER
UID=1000
GID=1000

# PostgreSQL Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weixing-db
POSTGRES_USER=weixing
POSTGRES_PASSWORD=

# OSS Configuration
OSS_ACCESS_KEY_ID=LTAI5tKUjtEg25unLmSQpBCg
OSS_ACCESS_KEY_SECRET=

# 测量服务 API 配置
MEASUREMENT_API_URL=https://weixing-measurement-service-configuration.dev.yijunstudio.xyz/api/sensors/data

# Image tag
TAG=latest

# Port mapping
HOST_PORT=8080
WS_PORT=8080

# For backend-service
# 您可以根据需要取消注释并配置这些变量
# 报警串口（指示灯控制）
ALARM_SERIAL_PORT=/dev/ttyUSB0
ALARM_WITH_SOUND=true
# 继电器串口
RELAY_SERIAL_PORT=/dev/ttyUSB1
# 图片保留时间（小时）
FAIL_RETENTION_HOURS=336  # fail标签保留14天
DEFAULT_RETENTION_HOURS=24 # 其他标签保留1天

# For udp-server
LIGHT_ACTIVE=true
# 偏心补偿模型路径（默认使用镜像内 ecc_model.json，设为空则跳过偏心补偿）
# ECC_MODEL_PATH=
# 如需禁用偏心补偿，取消注释上面一行

# Common variables for services
WS_SERVER=ws://websocket-server:8080

# 后端服务 URL（udp-server 等由此拼接 /api/parameters、/api/measurements、/api/relay 等）
WEIXING_SERVICE_BASE_URL=http://backend-service:3000
# 以下为完整 API 地址，供需要直接使用完整 URL 的服务（如 tcp-server）覆盖
WEIXING_SERVICE_PARAMETERS_API_URL=http://backend-service:3000/api/parameters
WEIXING_SERVICE_MEASUREMENTS_API_URL=http://backend-service:3000/api/measurements
WEIXING_SERVICE_QUALITY_API_URL=http://backend-service:3000/api/quality-records

# For frontend
WEBSOCKET_SERVER=ws://websocket-server:8080
HTTP_SERVER=http://backend-service:3000

# ==================== TCP 服务配置 ====================
# TCP服务器监听端口
TCP_PORT=8999

# TCP处理队列大小（最大排队数据包数量）
TCP_QUEUE_SIZE=100

# TCP最大并发处理数量
TCP_MAX_HANDLERS=12

# ==================== WebSocket 配置 ====================
# WebSocket服务器地址
WS_SERVER=ws://websocket-server:8080

# ==================== 图像处理配置 ====================
# 图像尺寸调整
IMAGE_RESIZE_WIDTH=400
IMAGE_RESIZE_HEIGHT=300

# JPEG压缩质量 (1-100，数值越高质量越好但文件越大)
IMAGE_JPEG_QUALITY=60

# 临时文件夹最大文件数量（超过会自动清理旧文件）
IMAGE_TEMP_MAX_FILES=1000

# ==================== 文件保存策略 ====================
# 保存策略选项:
# - none: 不保存任何图片到本地
# - random: 按设定概率随机保存
# - all: 保存所有图片到本地
SAVE_STRATEGY=all

# 各类型图片的保存概率 (0.0-1.0)
SAVE_PASS_RATE=0.001        # pass图片保存概率 1%
SAVE_INVALID_RATE=0.001    # invalid图片保存概率 0.1%
SAVE_FAIL_RATE=1.0         # fail图片保存概率 100%

# ==================== 上传策略 ====================
# 上传策略选项:
# - none: 不上传任何图片到OSS
# - selective: fail图片总是上传，其他按保存概率上传
# - all: 上传所有图片到OSS
UPLOAD_STRATEGY=selective

# OSS上传路径配置
UPLOAD_PATH_PASS=weixing/test/
UPLOAD_PATH_FAIL=weixing/error/fail/
UPLOAD_PATH_INVALID=weixing/error/invalid/

# ==================== API 服务配置 ====================
# API服务基础URL
API_BASE_URL=http://backend-service:3000/api

# API端点路径
API_PARAMETERS=/parameters
API_MEASUREMENTS=/measurements
API_QUALITY=/quality-records

# ==================== OSS 配置 ====================
# 阿里云OSS访问密钥
# OSS_ACCESS_KEY_ID=your_access_key_id_here
# OSS_ACCESS_KEY_SECRET=your_access_key_secret_here

# OSS服务端点
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# OSS存储桶名称
OSS_BUCKET=tongrang-materials

# ==================== 日志配置 ====================
# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# ==================== 监控配置(可选)====================
# 注册 https://grafana.com/auth/sign-up/create-user (选 Free tier)
# 在 "My Account" -> Prometheus -> "Details" 页拿到以下三项
# 三项都填了才启动监控: docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_PASSWORD=

# ==================== 环境配置示例 ====================

# 开发环境配置示例:
# SAVE_STRATEGY=random
# SAVE_PASS_RATE=0.001
# UPLOAD_STRATEGY=none
# LOG_LEVEL=debug

# 生产环境配置示例:
# SAVE_STRATEGY=random
# SAVE_FAIL_RATE=1.0
# SAVE_PASS_RATE=0.01
# UPLOAD_STRATEGY=selective
# LOG_LEVEL=info

# 调试环境配置示例:
# SAVE_STRATEGY=all
# UPLOAD_STRATEGY=none
# LOG_LEVEL=debug 
# ==================== 无喷码报警配置 ====================
# 三路相机最新帧同时 has_code=false，且持续 NO_CODE_ALARM_DURATION_MS → 触发报警。
# 判定在 weixing-service 汇总，各 tcp-server 只负责上报自己那一路。
NO_CODE_ALARM_ENABLED=false
# 持续多久触发报警（毫秒），默认 30 秒 —— weixing-service
NO_CODE_ALARM_DURATION_MS=30000
# 单路相机最新帧超过此时长视为陈旧，不参与判定（停机/断线不误报）—— weixing-service
NO_CODE_STALE_MS=5000
# 需要同时无喷码的相机路数 —— weixing-service
NO_CODE_CAMERA_COUNT=3
# service 侧周期评估间隔（毫秒）
NO_CODE_EVAL_INTERVAL_MS=1000
# tcp-server 侧上报间隔（毫秒）
NO_CODE_REPORT_INTERVAL_MS=1000
